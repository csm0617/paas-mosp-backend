<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.csm.paas.core</groupId>
        <artifactId>paas-core</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>
    <artifactId>paas-core-trigger</artifactId>
    <packaging>jar</packaging>
    <dependencies>
        <dependency>
            <groupId>com.csm.paas.core</groupId>
            <artifactId>paas-core-api</artifactId>
        </dependency>
        <dependency>
            <groupId>com.csm.paas.core</groupId>
            <artifactId>paas-core-case</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-websocket</artifactId>
        </dependency>
        <!-- 厂商 `generateExportExcel*` 用 HSSFWorkbook（xls）。本机离线仓已有 poi 4.1.2/5.2.5/5.3.0。 -->
        <dependency>
            <groupId>org.apache.poi</groupId>
            <artifactId>poi</artifactId>
            <version>5.2.5</version>
        </dependency>
        <!-- 厂商 `ValidateUtils.isExcelFile` 用 Tika 做 MIME 探测（本机离线仓已有 1.24.1/2.9.2） -->
        <dependency>
            <groupId>org.apache.tika</groupId>
            <artifactId>tika-core</artifactId>
            <version>2.9.2</version>
        </dependency>
        <!--
          `/v1/user/import` 用 `WorkbookFactory.create`（厂商 `UserService.java:1034`）——它同时支持
          xls 与 xlsx，xlsx 需要 poi-ooxml（否则抛 UnsupportedFileFormatException）。
          厂商的 MIME 守卫本来就把 xlsx 列为合法，所以这里必须一起支持（离线仓已有 5.2.5 全套传递依赖）。
        -->
        <dependency>
            <groupId>org.apache.poi</groupId>
            <artifactId>poi-ooxml</artifactId>
            <version>5.2.5</version>
        </dependency>
    </dependencies></project>
